<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.LightCamera" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#B8C4FF</item>
        <item name="colorOnPrimary">#002584</item>
        <item name="colorPrimaryContainer">#0038B9</item>
        <item name="colorOnPrimaryContainer">#DCE1FF</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">#C3C5DD</item>
        <item name="colorOnSecondary">#2C2F42</item>
        <item name="colorSecondaryContainer">#434659</item>
        <item name="colorOnSecondaryContainer">#DFE1F9</item>

        <!-- Tertiary brand color. -->
        <item name="colorTertiary">#E5BAD7</item>
        <item name="colorOnTertiary">#44263E</item>
        <item name="colorTertiaryContainer">#5C3D55</item>
        <item name="colorOnTertiaryContainer">#FFD7F3</item>

        <!-- Neutral / Surface colors -->
        <item name="android:windowBackground">#1B1B1F</item>
        <item name="colorSurface">#1B1B1F</item>
        <item name="colorOnSurface">#E4E2E6</item>
        <item name="colorSurfaceVariant">#45464F</item>
        <item name="colorOnSurfaceVariant">#C6C6D0</item>
        <item name="colorOutline">#90909A</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <style name="Theme.LightCamera.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>